<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiayuan.modules.log.dao.LogLoginDao">

    <!--登录日志清理-->
    <delete id="clearLog">
        DELETE
        FROM log_login
        WHERE loginTime <![CDATA[ <= ]]> #{date}
    </delete>
</mapper>