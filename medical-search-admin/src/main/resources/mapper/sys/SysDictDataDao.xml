<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiayuan.modules.sys.dao.SysDictDataDao">

    <select id="getDictDataList" resultType="com.jiayuan.modules.sys.entity.DictData">
        select dict_type, dict_label, dict_value
        from sys_dict_data
        order by dict_type, sort
    </select>

</mapper>