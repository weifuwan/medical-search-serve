<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 定义日志目录 -->
    <property name="DEBUG_LOG_PATH" value="/usr/local/appLog/debug"/>
    <property name="INFO_LOG_PATH" value="/usr/local/appLog/info"/>
    <property name="WARN_LOG_PATH" value="/usr/local/appLog/warn"/>
    <property name="ERROR_LOG_PATH" value="/usr/local/appLog/error"/>
    <!-- 定义日志保留天数 -->
    <property name="MAX_HISTORY" value="7"/>
    <!-- 定义日志文件总大小 -->
    <property name="TOTAL_SIZE_CAP" value="10GB"/>
    <!-- 定义单个日志文件大小 -->
    <property name="MAX_FILE_SIZE" value="50MB"/>

    <!--日志输出到logstash-->
    <!--    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">-->
